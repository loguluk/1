-- Turtle Client Agent v4.0 (turtle_21)
-- Smart Silo Storing & Direct Cable Transfer (No Dropping)

local modem = peripheral.find("modem")
if modem then
    rednet.open(peripheral.getName(modem))
end

print("=== TURTLE 21 CLIENT ONLINE ===")

local silos = {
    "create_connected:item_silo_94",
    "create_connected:item_silo_95",
    "create_connected:item_silo_96",
    "create_connected:item_silo_97",
    "create_connected:item_silo_98",
    "create_connected:item_silo_101",
    "create_connected:item_silo_100",
    "create_connected:item_silo_99"
}

function scanGrid()
    local gridData = {}
    for slot = 1, 16 do
        local detail = turtle.getItemDetail(slot)
        if detail then
            gridData[slot] = {
                name = detail.name,
                count = detail.count
            }
        end
    end
    return gridData
end

-- Поиск свободного силоса и отгрузка предметов по проводной сети
function pushToAvailableSilo(turtleSlot)
    for _, siloName in ipairs(silos) do
        if peripheral.isPresent(siloName) then
            local silo = peripheral.wrap(siloName)
            if silo and silo.pushItems then
                -- pushItems возвращает количество успешно переданных предметов
                local moved = turtle.pushItems(siloName, turtleSlot)
                if moved > 0 then
                    print(string.format("Moved %d items to %s", moved, siloName))
                    if turtle.getItemCount(turtleSlot) == 0 then
                        return true
                    end
                end
            end
        end
    end
    return turtle.getItemCount(turtleSlot) == 0
end

function clearAllSlotsToSilos()
    for i = 1, 16 do
        if turtle.getItemCount(i) > 0 then
            turtle.select(i)
            local success = pushToAvailableSilo(i)
            if not success then
                print(string.format("Warning: All Silos Full! Item left in slot %d", i))
            end
        end
    end
    turtle.select(1)
end

while true do
    local senderId, message, protocol = rednet.receive("factory_net")
    if type(message) == "table" then
        if message.command == "SCAN" then
            local data = scanGrid()
            rednet.send(senderId, { status = "OK", grid = data }, "factory_net")

        elseif message.command == "CRAFT" then
            turtle.select(1)
            local success, err = turtle.craft()
            rednet.send(senderId, { status = success and "OK" or "FAIL", err = err }, "factory_net")

        elseif message.command == "CLEAR_ALL" then
            clearAllSlotsToSilos()
            rednet.send(senderId, { status = "OK" }, "factory_net")
        end
    end
end
