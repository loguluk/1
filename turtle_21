-- Turtle Client Agent v6.0 (turtle_21)
-- Fixed line 59: Uses silo.pullItems instead of invalid turtle.pushItems

local modem = peripheral.find("modem")
local turtleName = nil

if modem then
    local modemName = peripheral.getName(modem)
    rednet.open(modemName)
    turtleName = modemName
end

print("=== TURTLE 21 CLIENT ONLINE ===")

local silos = {
    "create_connected:item_silo_94",
    "create_connected:item_silo_95",
    "create_connected:item_silo_96",
    "create_connected:item_silo_97",
    "create_connected:item_silo_98",
    "create_connected:item_silo_101",
    "create_connected:item_silo_100",
    "create_connected:item_silo_99"
}

function scanGrid()
    local gridData = {}
    for slot = 1, 16 do
        local detail = turtle.getItemDetail(slot)
        if detail then
            gridData[slot] = {
                name = detail.name,
                count = detail.count
            }
        end
    end
    return gridData
end

-- Безопасная передача предметов из слота черепашки в свободный силос
function safeStoreItem(slotIdx)
    local item = turtle.getItemDetail(slotIdx)
    if not item or item.count == 0 then return true end

    for _, siloName in ipairs(silos) do
        if peripheral.isPresent(siloName) then
            local silo = peripheral.wrap(siloName)
            if silo and silo.pullItems then
                local moved = silo.pullItems(turtleName or "turtle_21", slotIdx, item.count)
                if moved and moved > 0 then
                    print(string.format("Stored %d x %s -> %s", moved, item.name:gsub(".*:", ""), siloName))
                    if turtle.getItemCount(slotIdx) == 0 then
                        return true
                    end
                end
            end
        end
    end

    print(string.format("Warning: No free silo space for slot %d", slotIdx))
    return false
end

function safeClearAllSlots()
    for i = 1, 16 do
        if turtle.getItemCount(i) > 0 then
            turtle.select(i)
            safeStoreItem(i)
        end
    end
    turtle.select(1)
end

while true do
    local senderId, message, protocol = rednet.receive("factory_net")
    if type(message) == "table" then
        if message.command == "SCAN" then
            local data = scanGrid()
            rednet.send(senderId, { status = "OK", grid = data }, "factory_net")

        elseif message.command == "CRAFT" then
            turtle.select(1)
            local success, err = turtle.craft()
            rednet.send(senderId, { status = success and "OK" or "FAIL", err = err }, "factory_net")

        elseif message.command == "CLEAR_ALL" then
            safeClearAllSlots()
            rednet.send(senderId, { status = "OK" }, "factory_net")
        end
    end
end
