-- Turtle Client Agent (turtle_21)
-- Save as startup.lua on the Crafting Turtle!

local modem = peripheral.find("modem")
if modem then
    rednet.open(peripheral.getName(modem))
end

print("=== TURTLE 21 CLIENT ONLINE ===")

function scanGrid()
    local gridData = {}
    for slot = 1, 16 do
        local detail = turtle.getItemDetail(slot)
        if detail then
            gridData[slot] = {
                name = detail.name,
                count = detail.count
            }
        end
    end
    return gridData
end

while true do
    local senderId, message, protocol = rednet.receive("factory_net")
    if type(message) == "table" then
        if message.command == "SCAN" then
            local data = scanGrid()
            rednet.send(senderId, { status = "OK", grid = data }, "factory_net")

        elseif message.command == "CRAFT" then
            turtle.select(1)
            local success, err = turtle.craft()
            if not success then
                print("Craft failed: " .. tostring(err))
            else
                print("Craft success!")
            end
            rednet.send(senderId, { status = success and "OK" or "FAIL", err = err }, "factory_net")

        elseif message.command == "CLEAR_SLOTS" then
            -- Сброс предметов из инвентаря
            for i = 1, 16 do
                if turtle.getItemCount(i) > 0 then
                    turtle.select(i)
                    turtle.dropUp()
                end
            end
            turtle.select(1)
            rednet.send(senderId, { status = "OK" }, "factory_net")
        end
    end
end
