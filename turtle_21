-- Turtle Crafting Agent v1.0
rednet.open("right") -- или другая сторона, где стоит модем

print("Turtle Crafting Agent started...")

while true do
    local senderId, message, protocol = rednet.receive("factory_net")
    
    if type(message) == "table" then
        if message.command == "SCAN" then
            -- Отправка текущего содержимого инвентаря для сканирования рецепта
            local grid = {}
            for slot = 1, 16 do
                local detail = turtle.getItemDetail(slot)
                if detail then
                    grid[slot] = { name = detail.name, count = detail.count }
                end
            end
            rednet.send(senderId, { status = "OK", grid = grid }, "factory_net")

        elseif message.command == "CRAFT" then
            local count = message.count or 1
            print("Received craft request for " .. count .. " items.")
            
            for c = 1, count do
                -- Выполняем стандартный верстачный крафт
                local success, err = turtle.craft()
                if success then
                    -- По твоему условию: готовый результат выкладывается/выбирается в 1-й слот
                    turtle.select(1)
                    print("Craft successful! Output in slot 1.")
                    -- Если снизу или сзади есть контейнер, сгружаем результат из 1 слота:
                    turtle.dropDown(turtle.getItemCount(1))
                else
                    print("Craft failed: " .. tostring(err))
                    break
                end
            end

            rednet.send(senderId, { status = "OK" }, "factory_net")
        end
    end
end
