-- Turtle Client Agent v5.0 (turtle_21)
-- Safe Storage Check (Zero Item Dropping)

local modem = peripheral.find("modem")
if modem then
    rednet.open(peripheral.getName(modem))
end

print("=== TURTLE 21 CLIENT ONLINE ===")

local silos = {
    "create_connected:item_silo_94",
    "create_connected:item_silo_95",
    "create_connected:item_silo_96",
    "create_connected:item_silo_97",
    "create_connected:item_silo_98",
    "create_connected:item_silo_101",
    "create_connected:item_silo_100",
    "create_connected:item_silo_99"
}

function scanGrid()
    local gridData = {}
    for slot = 1, 16 do
        local detail = turtle.getItemDetail(slot)
        if detail then
            gridData[slot] = {
                name = detail.name,
                count = detail.count
            }
        end
    end
    return gridData
end

-- Безопасная отправка с предварительной проверкой свободного слота
function safeStoreItem(slotIdx)
    local item = turtle.getItemDetail(slotIdx)
    if not item then return true end

    for _, siloName in ipairs(silos) do
        if peripheral.isPresent(siloName) then
            local silo = peripheral.wrap(siloName)
            if silo and silo.list then
                -- Проверяем наличие слотов или совпадение предметов
                local items = silo.list()
                local size = silo.size and silo.size() or 27
                
                -- Ищем неполный стак или свободный слот
                local targetSlot = nil
                for s = 1, size do
                    if not items[s] or (items[s].name == item.name and items[s].count < 64) then
                        targetSlot = s
                        break
                    end
                end

                if targetSlot then
                    local moved = turtle.pushItems(siloName, slotIdx, item.count, targetSlot)
                    if moved > 0 then
                        print(string.format("Safely stored %d x %s in %s (Slot %d)", moved, item.name:gsub(".*:", ""), siloName, targetSlot))
                        if turtle.getItemCount(slotIdx) == 0 then
                            return true
                        end
                    end
                end
            end
        end
    end

    print(string.format("WARNING: No free space found in Silos for slot %d!", slotIdx))
    return false
end

function safeClearAllSlots()
    for i = 1, 16 do
        if turtle.getItemCount(i) > 0 then
            turtle.select(i)
            safeStoreItem(i)
        end
    end
    turtle.select(1)
end

while true do
    local senderId, message, protocol = rednet.receive("factory_net")
    if type(message) == "table" then
        if message.command == "SCAN" then
            local data = scanGrid()
            rednet.send(senderId, { status = "OK", grid = data }, "factory_net")

        elseif message.command == "CRAFT" then
            turtle.select(1)
            local success, err = turtle.craft()
            rednet.send(senderId, { status = success and "OK" or "FAIL", err = err }, "factory_net")

        elseif message.command == "CLEAR_ALL" then
            safeClearAllSlots()
            rednet.send(senderId, { status = "OK" }, "factory_net")
        end
    end
end
